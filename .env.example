# Copy to .env (npm run setup does this and generates secrets for you).
# PostgreSQL connection. Docker Compose and the non-Docker option both use these defaults.
DATABASE_URL="postgresql://ateanne:ateanne@localhost:5432/ateanne_dev"
# Separate database for integration/E2E tests — never point this at production.
TEST_DATABASE_URL="postgresql://ateanne:ateanne@localhost:5432/ateanne_test"
# Public origin of the app; used for Origin/CSRF checks and share links.
APP_ORIGIN="http://localhost:3000"
# Stable private key for HMAC-SHA256 join-code hashing and code encryption. 32+ random bytes, base64.
# Changing it invalidates every outstanding join code.
JOIN_CODE_HASH_KEY=""
# Private image directory, OUTSIDE public/. Must be a persistent volume in production.
PRIVATE_UPLOAD_DIR="./storage/uploads"
# Bearer token required by POST /api/maintenance/cleanup (cron). 32+ random bytes.
CLEANUP_TOKEN=""
