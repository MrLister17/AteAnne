{
  "name": "ateanne",
  "version": "0.10.0",
  "private": true,
  "description": "Hatian: mobile-first shared-expense app with exact-centavo item splitting and recipient-verified settlement",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs && prisma migrate deploy && prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:reference": "python3 -I reference/AteAnne_Reference_Calculations.py",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:reset": "tsx scripts/reset-test-db.ts",
    "data:cleanup": "tsx scripts/cleanup.ts",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "groq-sdk": "1.6.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
